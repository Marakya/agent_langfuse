# Все команды запускаются из корня проекта. Секреты остаются только в .env.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Судья не меняется между экспериментами, даже когда меняется эмбеддер RAG.
JUDGE_MODEL=gpt-4o-mini
JUDGE_MAX_OUTPUT_TOKENS=4096
JUDGE_EMBEDDING_MODEL=text-embedding-3-small
# Можно задать отдельного провайдера судьи. Пустые значения наследуют OPENAI_*.
JUDGE_API_KEY=
JUDGE_BASE_URL=

# SQLite создаётся автоматически; для PostgreSQL см. README.
DATABASE_URL=sqlite:///data/chat.db
HISTORY_TURNS=6
MAX_QUESTION_CHARS=4000
MAX_OUTPUT_TOKENS=1200
REQUEST_TIMEOUT=90

QDRANT_URL=
QDRANT_API_KEY=
# Альтернатива Docker: QDRANT_URL=local и путь ниже (только один процесс).
QDRANT_PATH=data/qdrant
DOCUMENTS_DIR=data/knowledge
INDEX_DIR=artifacts/indexes
RAG_CONFIG=configs/baseline.yaml

# Отправка трасс, датасетов и результатов в Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Ragas не отправляет свою продуктовую телеметрию.
RAGAS_DO_NOT_TRACK=true
